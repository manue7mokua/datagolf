        "setup_text": "Some short TikToks punch above their weight.",
        "task_text": "Find the top 5 posts with the highest engagement rate among videos shorter than 30 seconds.",
        "hint_chips": [
          "mutate",
          "filter",
          "arrange",
          "desc",
          "head"
        ],
        "answer_format": "prompt"
      },
      "strong_prompt_implications": [
        "Create engagement rate as (likes + comments + shares) / views.",
        "Keep only rows where video_length_sec < 30.",
        "Sort from highest to lowest engagement rate.",
        "Return the top 5 posts."
      ],
      "evaluation": {
        "kind": "guided_prompt",
        "operation": "q1_short_video_engagement",
        "result_limit": 5,
        "round_decimals": 6,
        "expected_columns": [
          "post_id",
          "creator_handle",
          "engagement_rate"
        ],
        "expected_rows": [
